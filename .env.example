# Copy to .env

# Telegram
BOT_TOKEN=
WEBHOOK_SECRET=change-me

# Optional: any OpenAI-compatible endpoint.
# Groq   -> https://api.groq.com/openai/v1        model: llama-3.3-70b-versatile
# Google -> https://generativelanguage.googleapis.com/v1beta/openai
# OpenAI -> https://api.openai.com/v1            model: gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Rate limiting for the public demo (messages per minute per IP)
RATE_LIMIT=8

# Where the SQLite file and the knowledge base live
BOT_DB=bot.db
BOT_KNOWLEDGE=knowledge.md
